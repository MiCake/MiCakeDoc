---
// 覆盖 Starlight 默认 PageTitle：在文档标题旁添加「查看 Markdown 原文」快捷按钮
// 链接指向 /api/raw-markdown/{id}.txt —— 与 llms.txt 中 AI 使用的地址一致
// 注：id="_top" 与 Starlight 的 PAGE_TITLE_ID 常量一致（跳过链接定位锚点）
const { entry, locale } = Astro.locals.starlightRoute;
const isEnglish = locale === 'en';
const rawUrl = `/api/raw-markdown/${entry.id}.txt`;
const label = isEnglish ? 'View Markdown' : 'Markdown 原文';
const tooltip = isEnglish
	? `Open raw markdown source: ${rawUrl}`
	: `打开 Markdown 原文：${rawUrl}`;
---

<div class="title-row">
	<h1 id="_top">{entry.data.title}</h1>
	<a class="raw-link" href={rawUrl} title={tooltip}>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width="1em"
			height="1em"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
			<polyline points="14 2 14 8 20 8" />
			<line x1="16" y1="13" x2="8" y2="13" />
			<line x1="16" y1="17" x2="8" y2="17" />
			<polyline points="10 9 9 9 8 9" />
		</svg>
		<span>{label}</span>
	</a>
</div>

<style>
	.title-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		margin-top: 1rem;
	}

	h1 {
		margin: 0;
		font-size: var(--sl-text-h1);
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.raw-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.35em 0.85em;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 999px;
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-text);
		font-size: 0.78em;
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			background-color 0.2s ease;
	}

	.raw-link:hover {
		border-color: var(--brand-primary, #ff9f1c);
		color: var(--brand-primary, #ff9f1c);
		background-color: color-mix(in srgb, var(--brand-primary, #ff9f1c) 10%, transparent);
	}

	@media print {
		.raw-link {
			display: none;
		}
	}
</style>
