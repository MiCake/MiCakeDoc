---
// 覆盖 Starlight 默认 EditLink：在「编辑此页」链接旁添加「查看 Markdown 原文」按钮。
// 原实现位于自定义 PageTitle（src/components/PageTitle.astro，已删除）。
// 为消除 starlight-versions 的 PageTitle override 冲突警告，按钮迁移至此，
// PageTitle 交还插件自动注入（默认标题 + 版本横幅）。
// 链接指向 /api/raw-markdown/{id}.txt —— 与 llms.txt 中 AI 使用的地址一致
import Default from '@astrojs/starlight/components/EditLink.astro';

const { entry, locale } = Astro.locals.starlightRoute;
const isEnglish = locale === 'en';
const rawUrl = entry ? `/api/raw-markdown/${entry.id}.txt` : null;
const label = isEnglish ? 'View Markdown' : 'Markdown 原文';
const tooltip = rawUrl
	? isEnglish
		? `Open raw markdown source: ${rawUrl}`
		: `打开 Markdown 原文：${rawUrl}`
	: '';
---

<div class="edit-row sl-flex print:hidden">
	<Default />
	{
		rawUrl && (
			<a href={rawUrl} class="raw-link sl-flex" title={tooltip}>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="1.2em"
					height="1.2em"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
					<polyline points="14 2 14 8 20 8" />
					<line x1="16" y1="13" x2="8" y2="13" />
					<line x1="16" y1="17" x2="8" y2="17" />
					<polyline points="10 9 9 9 8 9" />
				</svg>
				<span>{label}</span>
			</a>
		)
	}
</div>

<style>
	@layer starlight.core {
		.edit-row {
			gap: 1.25rem;
			align-items: center;
			flex-wrap: wrap;
		}

		.raw-link {
			gap: 0.5rem;
			align-items: center;
			text-decoration: none;
			color: var(--sl-color-gray-3);
			transition: color 0.2s ease;
		}

		.raw-link:hover {
			color: var(--sl-color-white);
		}
	}
</style>
